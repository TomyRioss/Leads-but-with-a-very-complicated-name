NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Owner analytics (server-only): personal API key with query:read scope + numeric project id.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# POSTHOG_API_HOST=https://us.posthog.com
RESEND_API_KEY=
# Keep this value stable across app instances so outstanding verification links remain valid.
EMAIL_VERIFICATION_SECRET=
LINEAR_API_KEY=
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" (Lead Suite weekly report).
CRON_SECRET=
# People search (Buscar personas): Serper web search key; optional GitHub token for higher API rate limits.
SERPER_API_KEY=
GITHUB_TOKEN=
# Google Drive connector (Leadtita): reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET. Picker key + numeric project number.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
# 32 random bytes in base64 (e.g. `openssl rand -base64 32`); rotating it disconnects every Google account.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# "true" enables full read-only Drive search (drive.readonly; needs Google verification). Off by default.
GOOGLE_DRIVE_FULL_ACCESS=
