# Shared secret with the Next.js app (min 32 chars). Generate: openssl rand -hex 32
WHATSAPP_WORKER_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Next.js endpoint that receives sent/failed/replied callbacks
WHATSAPP_CALLBACK_URL=https://leadta.app/api/integrations/whatsapp/events
PORT=8787
DATA_DIR=/data
MIN_DELAY_S=45
MAX_DELAY_S=120
LOG_LEVEL=warn
